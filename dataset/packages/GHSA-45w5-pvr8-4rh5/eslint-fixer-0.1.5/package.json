{
  "name": "eslint-fixer",
  "version": "0.1.5",
  "description": "Promise based function to apply `eslint --fix` to given directory or files.",
  "repository": "ozum/eslint-fixer",
  "main": "index.js",
  "files": [
    "lib/",
    "index.js"
  ],
  "scripts": {
    "test": "nyc mocha && eslint . --ignore-path .gitignore",
    "doc": "jsdoc2md *.js lib/*.js | replace-between --target README.md --token API"
  },
  "keywords": [
    "eslint",
    "fix",
    "cli",
    "utility"
  ],
  "author": "Özüm Eldoğan",
  "license": "MIT",
  "devDependencies": {
    "babel-eslint": "^7.x",
    "code": "^4.x",
    "eslint-config-airbnb": "^14.x",
    "eslint-plugin-import": "^2.x",
    "eslint-plugin-jsx-a11y": "^4.x",
    "eslint-plugin-react": "^6.x",
    "fs-promise": "^2.x",
    "mocha": "^3.2.0",
    "nyc": "^10.1.2",
    "replace-between": "^0.x",
    "rewire": "^2.x"
  },
  "dependencies": {
    "p-wait-for": "^1.x"
  }
}
