{
  "name": "port-killer",
  "version": "1.0.1",
  "description": "Kills the process running on a given port (assuming you have permission to do so)",
  "author": "tyler peterson <tylerjpeterson@gmail.com>",
  "main": "index.js",
  "bin": {
    "portkill": "bin/port-killer.js"
  },
  "scripts": {
    "coverage": "istanbul cover tape ./test/spec/test.js --output coverage/coverage.json && npm run report",
    "report": "istanbul report --root coverage lcov && open coverage/lcov-report/index.html",
    "docs": "jsdoc index.js -p -c .jsdoc.json -d docs/",
    "test": "node test/spec/test.js | tap-spec",
    "lint": "xo ./index.js || true"
  },
  "dependencies": {},
  "devDependencies": {
    "istanbul": "^0.4.5",
    "tap-spec": "^4.1.1",
    "tape": "^4.6.3",
    "xo": "^0.18.2"
  },
  "bugs": {
    "url": "https://github.com/tylerjpeterson/port-killer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tylerjpeterson/port-killer"
  },
  "homepage": "https://github.com/tylerjpeterson/port-killer",
  "contributors": [
    ""
  ],
  "xo": {
    "globals": [
      "assert",
      "beforeEach",
      "describe",
      "expect",
      "it",
      "module",
      "require"
    ]
  },
  "keywords": [],
  "engines": {
    "node": ">=8.7.0"
  },
  "license": "MIT"
}
