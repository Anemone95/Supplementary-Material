{
  "extends": "airbnb/base",
  "env": {
    "node": true,
    "es6": true,
    "browser": false,
    "commonjs": true
  },
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "script",
    "allowImportExportEverywhere": false,
    "ecmaFeatures": {
      "impliedStrict": true,
      "jsx": false,
      "experimentalObjectRestSpread": true
    }
  },
  "rules": {
    "comma-dangle": 0,
    "no-console": 0,
    "no-param-reassign": 0,
    "max-len": 0
  }
}
